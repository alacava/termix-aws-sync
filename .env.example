# Copy this file to .env and fill in real values.
#   cp .env.example .env

# --- Termix auth (both required) ---
# API key from the Termix web UI (Settings -> API Keys). Never put a real
# key in config.toml -- it must only ever come from this env var. Sent as
# an `Authorization: Bearer` header to the Termix REST API.
TERMIX_API_KEY=replace-with-your-termix-api-key

# Base URL of your Termix server. Required -- Termix is accessed via its
# REST API directly, so there's no CLI-configured server to fall back on.
TERMIX_URL=https://termix.example.com

# --- Sync behavior ---
# Seconds between sync cycles in the container's loop mode. Omit (or unset)
# to fall back to the default of 900 (15 minutes). Ignored for one-shot runs
# like `docker compose run --rm sync --dry-run`.
SYNC_INTERVAL=3600

# Overrides the global [aws].ip_source from config.toml -- useful to flip
# internal/external per-deployment without editing the mounted config.
# Accepted values: private/internal or public/external.
# IP_SOURCE=internal

# --- AWS auth (alternative to mounting ~/.aws, see docker-compose.yml) ---
# Only needed if you're not mounting ~/.aws read-only into the container.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# --- Config file location (advanced) ---
# The compose file already mounts config.toml to /etc/termix-aws-sync.toml,
# which is on the default search path, so this is normally unnecessary.
# TERMIX_AWS_SYNC_CONFIG=/etc/termix-aws-sync.toml
