#!/usr/bin/env python3
"""Fake `termix` CLI for the end-to-end test.

Serves `hosts list --tag ... --json` with two managed hosts (one that will
drift against the fake `aws` instance list, one orphaned/terminated), and
logs every create/update/delete invocation as one JSON line to the file
named by the TAS_TEST_LOG env var, so the test can assert exactly which
operations ran.
"""
import json
import os
import sys

# id 101 -> i-0000000000000aaa1 (ip will drift vs. the fake aws output)
# id 102 -> i-0000000000000bbb2 (not present in the fake aws output -> delete)
HOSTS = [
    {
        "id": 101,
        "name": "existing-drifted",
        "ip": "10.0.0.1",
        "port": 22,
        "username": "ec2-user",
        "tags": ["aws", "aws-sync", "aws-id-i-0000000000000aaa1", "us-east-1"],
        "folder": "AWS",
    },
    {
        "id": 102,
        "name": "orphaned",
        "ip": "10.0.0.2",
        "port": 22,
        "username": "ec2-user",
        "tags": ["aws", "aws-sync", "aws-id-i-0000000000000bbb2", "us-east-1"],
        "folder": "AWS",
    },
]


def log_call(action, rest):
    log_path = os.environ.get("TAS_TEST_LOG")
    if not log_path:
        return
    with open(log_path, "a") as fh:
        fh.write(json.dumps({"action": action, "argv": rest}) + "\n")


if __name__ == "__main__":
    args = sys.argv[1:]
    if args[:2] == ["hosts", "list"]:
        print(json.dumps(HOSTS))
        sys.exit(0)
    if args[:2] in (["hosts", "create"], ["hosts", "update"], ["hosts", "delete"]):
        log_call(args[1], args[2:])
        sys.exit(0)
    print(f"unsupported invocation: {args}", file=sys.stderr)
    sys.exit(1)
